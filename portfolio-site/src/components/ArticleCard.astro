---
import { formatDate } from '../utils/dates';
import TagBadge from './TagBadge.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  readingMinutes?: number;
  severity?: string;
  featured?: boolean;
}

const { href, title, description, pubDate, category, tags = [], readingMinutes, severity, featured = false } = Astro.props;

const severityColor: Record<string, string> = {
  critical: 'text-red-700 bg-red-50 border-red-200 dark:text-red-400 dark:bg-red-950 dark:border-red-900',
  high: 'text-orange-700 bg-orange-50 border-orange-200 dark:text-orange-400 dark:bg-orange-950 dark:border-orange-900',
  medium: 'text-amber-700 bg-amber-50 border-amber-200 dark:text-amber-400 dark:bg-amber-950 dark:border-amber-900',
  low: 'text-emerald-700 bg-emerald-50 border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950 dark:border-emerald-900',
  informational: 'text-stone-600 bg-stone-50 border-stone-200 dark:text-stone-400 dark:bg-stone-900 dark:border-stone-800',
};
---
<article class:list={['group relative overflow-hidden rounded-lg border border-stone-200 bg-stone-50/60 p-5 pl-6 transition hover:border-accent-300 hover:shadow-sm dark:border-stone-800 dark:bg-stone-900/30 dark:hover:border-accent-700', featured && 'sm:col-span-2']}>
  <span class="absolute inset-y-0 left-0 w-1 bg-stone-200 transition group-hover:bg-accent-600 dark:bg-stone-800"></span>
  <div class="mb-2 flex flex-wrap items-center gap-2 font-mono text-xs">
    <span class="font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">{category}</span>
    <span class="text-stone-300 dark:text-stone-700">&middot;</span>
    <time datetime={pubDate.toISOString()} class="text-stone-500 dark:text-stone-400">{formatDate(pubDate)}</time>
    {readingMinutes && (
      <>
        <span class="text-stone-300 dark:text-stone-700">&middot;</span>
        <span class="text-stone-500 dark:text-stone-400">{readingMinutes} min read</span>
      </>
    )}
    {severity && (
      <span class:list={['rounded border px-1.5 py-0.5 font-medium uppercase', severityColor[severity] ?? severityColor.informational]}>
        {severity}
      </span>
    )}
  </div>

  <h3 class="text-lg font-semibold text-stone-900 dark:text-white">
    <a href={href} class="after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="mt-1.5 line-clamp-2 text-sm text-stone-600 dark:text-stone-400">{description}</p>

  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 4).map((tag) => (
        <TagBadge label={tag} />
      ))}
    </div>
  )}
</article>
