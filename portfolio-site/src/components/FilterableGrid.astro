---
import ArticleCard from './ArticleCard.astro';

interface Item {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  readingMinutes?: number;
  severity?: string;
  featured?: boolean;
}

interface Props {
  items: Item[];
  showSearch?: boolean;
  idPrefix: string;
  emptyLabel?: string;
}

const { items, showSearch = true, idPrefix, emptyLabel = 'No articles match these filters.' } = Astro.props;

const categories = [...new Set(items.map((item) => item.category))].sort();
const tags = [...new Set(items.flatMap((item) => item.tags))].sort();
---
<div data-filter-root={idPrefix}>
  <div class="mb-6 flex flex-col gap-4">
    {showSearch && (
      <input
        type="search"
        data-role="search"
        placeholder="Search articles…"
        class="w-full rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:border-accent-400 focus:outline-none focus:ring-1 focus:ring-accent-400 dark:border-stone-700 dark:bg-stone-900 dark:text-white sm:max-w-sm"
      />
    )}

    <div class="flex flex-wrap gap-2">
      <button type="button" data-role="category" data-value="all" aria-pressed="true" class="filter-pill filter-pill-active">
        All
      </button>
      {categories.map((category) => (
        <button type="button" data-role="category" data-value={category} aria-pressed="false" class="filter-pill">
          {category}
        </button>
      ))}
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <button type="button" data-role="tag" data-value={tag} aria-pressed="false" class="tag-pill">
            #{tag}
          </button>
        ))}
      </div>
    )}
  </div>

  <div data-role="grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {items.map((item) => (
      <div
        data-role="item"
        data-category={item.category}
        data-tags={item.tags.join('|')}
        data-search={`${item.title} ${item.description}`.toLowerCase()}
      >
        <ArticleCard
          href={item.href}
          title={item.title}
          description={item.description}
          pubDate={item.pubDate}
          category={item.category}
          tags={item.tags}
          readingMinutes={item.readingMinutes}
          severity={item.severity}
          featured={item.featured}
        />
      </div>
    ))}
  </div>

  <p data-role="empty" class:list={["py-12 text-center text-sm text-stone-500 dark:text-stone-400", { hidden: items.length > 0 }]}>{items.length === 0 ? "Coming Soon" : emptyLabel}</p>
</div>

<style>
  .filter-pill {
    border-radius: 9999px;
    border: 1px solid var(--color-stone-200);
    padding: 0.3rem 0.85rem;
    font-size: 0.8125rem;
    color: var(--color-stone-600);
    transition: all 0.15s ease;
  }
  :global(html.dark) .filter-pill {
    border-color: var(--color-stone-700);
    color: var(--color-stone-300);
  }
  .filter-pill-active {
    background: var(--color-accent-600);
    border-color: var(--color-accent-600);
    color: white;
  }
  .tag-pill {
    border-radius: 9999px;
    border: 1px dashed var(--color-stone-300);
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
    color: var(--color-stone-500);
  }
  :global(html.dark) .tag-pill {
    border-color: var(--color-stone-700);
    color: var(--color-stone-400);
  }
  .tag-pill[aria-pressed='true'] {
    background: var(--color-accent-50);
    border-color: var(--color-accent-400);
    color: var(--color-accent-700);
  }
  :global(html.dark) .tag-pill[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-accent-900) 40%, transparent);
    color: var(--color-accent-400);
  }
</style>

<script>
  function initFilterRoot(root: Element) {
    const searchInput = root.querySelector<HTMLInputElement>('[data-role="search"]');
    const categoryButtons = root.querySelectorAll<HTMLButtonElement>('[data-role="category"]');
    const tagButtons = root.querySelectorAll<HTMLButtonElement>('[data-role="tag"]');
    const items = root.querySelectorAll<HTMLElement>('[data-role="item"]');
    const emptyState = root.querySelector<HTMLElement>('[data-role="empty"]');

    let activeCategory = 'all';
    const activeTags = new Set<string>();

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;

      items.forEach((item) => {
        const matchesCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
        const itemTags = (item.dataset.tags ?? '').split('|');
        const matchesTags = activeTags.size === 0 || [...activeTags].every((tag) => itemTags.includes(tag));
        const matchesSearch = query === '' || (item.dataset.search ?? '').includes(query);
        const visible = matchesCategory && matchesTags && matchesSearch;
        item.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      emptyState?.classList.toggle('hidden', visibleCount !== 0);
    }

    searchInput?.addEventListener('input', applyFilters);

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.value ?? 'all';
        categoryButtons.forEach((b) => {
          const isActive = b === button;
          b.setAttribute('aria-pressed', String(isActive));
          b.classList.toggle('filter-pill-active', isActive);
        });
        applyFilters();
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.value ?? '';
        const isActive = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!isActive));
        if (isActive) activeTags.delete(value);
        else activeTags.add(value);
        applyFilters();
      });
    });
  }

  document.querySelectorAll('[data-filter-root]').forEach(initFilterRoot);
</script>
