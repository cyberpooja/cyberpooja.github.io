---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublished, articleHref, relatedByCategoryOrTags } from '../../utils/content';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const entries = await getPublished('blog');

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevEntry: index < entries.length - 1 ? entries[index + 1] : null,
      nextEntry: index > 0 ? entries[index - 1] : null,
      allEntries: entries,
    },
  }));
}

const { entry, prevEntry, nextEntry, allEntries } = Astro.props;
const { Content, headings } = await render(entry);

const related = relatedByCategoryOrTags(entry, allEntries).map((item) => ({
  href: articleHref('blog', item.id),
  title: item.data.title,
  description: item.data.description,
  pubDate: item.data.pubDate,
  category: item.data.category,
}));
---
<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  category={entry.data.category}
  tags={entry.data.tags}
  coverImage={entry.data.coverImage}
  coverImageAlt={entry.data.coverImageAlt}
  readingMinutes={readingTime(entry.body ?? '')}
  headings={headings}
  related={related}
  prev={prevEntry ? { href: articleHref('blog', prevEntry.id), title: prevEntry.data.title } : null}
  next={nextEntry ? { href: articleHref('blog', nextEntry.id), title: nextEntry.data.title } : null}
  sectionLabel="Blog"
  sectionHref="/blog/"
>
  <Content />
</ArticleLayout>
