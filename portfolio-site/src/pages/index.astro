---
import { withBase } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TagBadge from '../components/TagBadge.astro';
import { SITE, SOCIAL_LINKS } from '../site.config';
import { getPublished, articleHref, toolHref } from '../utils/content';
import { readingTime } from '../utils/readingTime';
import { formatDate } from '../utils/dates';

const research = await getPublished('research');
const blog = await getPublished('blog');
const tools = await getPublished('tools');

const latest = [...research, ...blog]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const featuredResearch = research.find((e) => e.data.featured) ?? research[0];
const featuredTools = tools.filter((t) => t.data.featured).slice(0, 2);

const interests = [
  'Android & mobile application security',
  'Web & API security, authentication/authorization flaws',
  'AI / LLM security (prompt injection, agentic tool-calling risks)',
  'Reverse engineering & static/dynamic analysis tooling',
  'Security automation & CI-integrated scanning',
];
---
<Layout title={SITE.title} description={SITE.description}>
  <div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <section class="relative overflow-hidden rounded-[28px] bg-accent-500 px-6 py-14 sm:px-12 sm:py-20">
      <p class="mb-5 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-navy/80">
        <span class="h-1.5 w-1.5 rounded-full bg-navy/80"></span>
        Independent security research
      </p>
      <h1 class="max-w-2xl text-4xl font-extrabold tracking-tight text-cream sm:text-6xl sm:leading-[1.05]">
        {SITE.tagline}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/90">{SITE.author.bio}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/research/')} class="inline-flex items-center gap-1.5 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-navy shadow-sm transition hover:bg-cream active:scale-[0.98]">
          Explore research <span aria-hidden="true">↗</span>
        </a>
        <a href={withBase('/tools/')} class="rounded-full border border-navy/70 px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-white/15 active:scale-[0.98]">
          View tools
        </a>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 text-sm">
        {SOCIAL_LINKS.map((link) => (
          <a href={link.href} class="text-navy/70 underline-offset-4 hover:text-navy hover:underline">
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </div>

    <section class="border-b border-stone-200 dark:border-stone-800">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <p class="index-label mb-1">01 — Featured</p>
            <h2 class="text-xl font-semibold text-stone-900 dark:text-white">Featured research</h2>
          </div>
          <a href={withBase('/research/')} class="text-sm text-accent-600 hover:underline dark:text-accent-400">View all &rarr;</a>
        </div>
        {featuredResearch ? (
        <article class="relative overflow-hidden rounded-xl border border-stone-200 bg-stone-50/60 p-6 pl-7 dark:border-stone-800 dark:bg-stone-900/30">
          <span class="absolute inset-y-0 left-0 w-1 bg-accent-600"></span>
          <div class="mb-2 flex flex-wrap items-center gap-2 font-mono text-xs">
            <span class="font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">{featuredResearch.data.category}</span>
            <span class="text-stone-300 dark:text-stone-700">&middot;</span>
            <time datetime={featuredResearch.data.pubDate.toISOString()} class="text-stone-500 dark:text-stone-400">
              {formatDate(featuredResearch.data.pubDate)}
            </time>
            {featuredResearch.data.severity && (
              <>
                <span class="text-stone-300 dark:text-stone-700">&middot;</span>
                <span class="font-medium uppercase text-stone-500 dark:text-stone-400">{featuredResearch.data.severity} severity</span>
              </>
            )}
          </div>
          <h3 class="text-2xl font-semibold text-stone-900 dark:text-white">
            <a href={articleHref('research', featuredResearch.id)} class="after:absolute after:inset-0">
              {featuredResearch.data.title}
            </a>
          </h3>
          <p class="mt-2 max-w-3xl text-stone-600 dark:text-stone-400">{featuredResearch.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {featuredResearch.data.tags.slice(0, 5).map((tag) => <TagBadge label={tag} />)}
          </div>
        </article>
        ) : <p class="py-12 text-center text-sm text-stone-500 dark:text-stone-400">Coming Soon</p>}
      </div>
    </section>

    <section class="border-b border-stone-200 dark:border-stone-800">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <p class="index-label mb-1">02 — Tools &amp; projects</p>
            <h2 class="text-xl font-semibold text-stone-900 dark:text-white">Open-source tools</h2>
          </div>
          <a href={withBase('/tools/')} class="text-sm text-accent-600 hover:underline dark:text-accent-400">View all &rarr;</a>
        </div>
        {featuredTools.length === 0 && <p class="py-12 text-center text-sm text-stone-500 dark:text-stone-400">Coming Soon</p>}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {featuredTools.map((tool) => (
            <article class="relative overflow-hidden rounded-lg border border-stone-200 bg-stone-50/60 p-5 pl-6 dark:border-stone-800 dark:bg-stone-900/30">
              <span class="absolute inset-y-0 left-0 w-1 bg-stone-200 dark:bg-stone-800"></span>
              <span class="font-mono text-xs font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">{tool.data.category}</span>
              <h3 class="mt-1 text-lg font-semibold text-stone-900 dark:text-white">
                <a href={toolHref(tool.id)} class="after:absolute after:inset-0">{tool.data.title}</a>
              </h3>
              <p class="mt-1.5 text-sm text-stone-600 dark:text-stone-400">{tool.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

  <section class="border-b border-stone-200 dark:border-stone-800">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="index-label mb-1">03 — Latest</p>
          <h2 class="text-xl font-semibold text-stone-900 dark:text-white">Latest publications</h2>
        </div>
        <a href={withBase('/blog/')} class="text-sm text-accent-600 hover:underline dark:text-accent-400">View all &rarr;</a>
      </div>
      {latest.length === 0 && <p class="py-12 text-center text-sm text-stone-500 dark:text-stone-400">Coming Soon</p>}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {latest.map((entry) => (
          <ArticleCard
            href={articleHref(entry.collection, entry.id)}
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            category={entry.data.category}
            tags={entry.data.tags}
            readingMinutes={readingTime(entry.body ?? '')}
          />
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
      <p class="index-label mb-1">04 — Focus areas</p>
      <h2 class="mb-6 text-xl font-semibold text-stone-900 dark:text-white">Research interests</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {interests.map((interest) => (
          <li class="flex gap-2 rounded-lg border border-stone-200 bg-stone-50/60 p-4 text-sm text-stone-700 dark:border-stone-800 dark:bg-stone-900/30 dark:text-stone-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400">
              <path d="m20 6-11 11-5-5" />
            </svg>
            <span>{interest}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
