---
import Layout from '../../layouts/Layout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPublished, toolHref } from '../../utils/content';
import { formatDate } from '../../utils/dates';

const tools = await getPublished('tools');

const statusStyles: Record<string, string> = {
  active: 'text-emerald-700 bg-emerald-50 border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950 dark:border-emerald-900',
  maintenance: 'text-amber-700 bg-amber-50 border-amber-200 dark:text-amber-400 dark:bg-amber-950 dark:border-amber-900',
  archived: 'text-stone-600 bg-stone-50 border-stone-200 dark:text-stone-400 dark:bg-stone-900 dark:border-stone-800',
};
---
<Layout title="Tools & Projects" description="Open-source security tools and automation projects, with documentation and GitHub repositories.">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-white">Tools &amp; Projects</h1>
      <p class="mt-3 text-stone-600 dark:text-stone-400">
        Open-source security tools and automation projects built out of research on this site. All MIT licensed
        unless noted otherwise in the repository.
      </p>
    </header>

    {tools.length === 0 && <p class="py-12 text-center text-sm text-stone-500 dark:text-stone-400">Coming Soon</p>}

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {tools.map((tool) => (
        <article class="relative rounded-lg border border-stone-200 p-5 transition hover:border-accent-300 hover:shadow-sm dark:border-stone-800 dark:hover:border-accent-700">
          <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">{tool.data.category}</span>
            <span class="text-stone-300 dark:text-stone-700">&middot;</span>
            <span class="text-stone-500 dark:text-stone-400">Updated {formatDate(tool.data.updatedDate ?? tool.data.pubDate)}</span>
            <span class:list={['rounded border px-1.5 py-0.5 font-medium capitalize', statusStyles[tool.data.status]]}>
              {tool.data.status}
            </span>
          </div>

          <h2 class="text-lg font-semibold text-stone-900 dark:text-white">
            <a href={toolHref(tool.id)} class="after:absolute after:inset-0">{tool.data.title}</a>
          </h2>
          <p class="mt-1.5 line-clamp-2 text-sm text-stone-600 dark:text-stone-400">{tool.data.description}</p>

          {tool.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tool.data.tags.slice(0, 4).map((tag) => (
                <TagBadge label={tag} />
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
