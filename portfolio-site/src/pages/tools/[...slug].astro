---
import { withBase } from '../../utils/paths';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPublished } from '../../utils/content';
import { formatDate } from '../../utils/dates';

export async function getStaticPaths() {
  const entries = await getPublished('tools');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

const statusStyles: Record<string, string> = {
  active: 'text-emerald-700 bg-emerald-50 border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950 dark:border-emerald-900',
  maintenance: 'text-amber-700 bg-amber-50 border-amber-200 dark:text-amber-400 dark:bg-amber-950 dark:border-amber-900',
  archived: 'text-stone-600 bg-stone-50 border-stone-200 dark:text-stone-400 dark:bg-stone-900 dark:border-stone-800',
};
---
<Layout title={data.title} description={data.description} image={data.coverImage} type="article" publishedTime={data.pubDate} modifiedTime={data.updatedDate}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <nav class="mb-6 text-sm text-stone-500 dark:text-stone-400">
      <a href={withBase('/tools/')} class="hover:text-accent-600 dark:hover:text-accent-400">Tools &amp; Projects</a>
      <span class="mx-1.5">/</span>
      <span class="text-stone-700 dark:text-stone-300">{data.title}</span>
    </nav>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_260px]">
      <article class="min-w-0">
        <header class="mb-8">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-medium uppercase tracking-wide text-accent-600 dark:text-accent-400">{data.category}</span>
            <span class="text-stone-300 dark:text-stone-700">&middot;</span>
            <span class:list={['rounded border px-1.5 py-0.5 font-medium capitalize', statusStyles[data.status]]}>
              {data.status}
            </span>
          </div>

          <h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl dark:text-white">{data.title}</h1>
          <p class="mt-3 text-lg text-stone-600 dark:text-stone-400">{data.description}</p>

          <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-stone-500 dark:text-stone-400">
            <time datetime={data.pubDate.toISOString()}>Released {formatDate(data.pubDate)}</time>
            {data.updatedDate && (
              <>
                <span class="text-stone-300 dark:text-stone-700">&middot;</span>
                <span>Updated {formatDate(data.updatedDate)}</span>
              </>
            )}
          </div>

          {data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {data.tags.map((tag) => <TagBadge label={tag} />)}
            </div>
          )}

          <div class="mt-6 flex flex-wrap gap-3">
            {data.repoUrl && (
              <a href={data.repoUrl} class="inline-flex items-center gap-2 rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-stone-700 dark:bg-white dark:text-stone-900 dark:hover:bg-stone-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                  <path d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.16.69-3.83-1.34-3.83-1.34-.52-1.3-1.26-1.65-1.26-1.65-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.74 2.65 1.24 3.3.94.1-.73.4-1.24.72-1.52-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.5-1.45.11-3.02 0 0 .96-.31 3.15 1.16a10.9 10.9 0 0 1 5.74 0c2.19-1.47 3.15-1.16 3.15-1.16.61 1.57.23 2.73.11 3.02.73.79 1.17 1.8 1.17 3.04 0 4.35-2.66 5.3-5.19 5.59.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .3.2.66.79.55A11.03 11.03 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z" />
                </svg>
                View on GitHub
              </a>
            )}
            {data.downloadUrl && (
              <a href={data.downloadUrl} class="inline-flex items-center rounded-full border border-stone-200 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-accent-300 dark:border-stone-700 dark:text-stone-200 dark:hover:border-accent-700">
                Download
              </a>
            )}
            {data.docsUrl && (
              <a href={data.docsUrl} class="inline-flex items-center rounded-full border border-stone-200 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-accent-300 dark:border-stone-700 dark:text-stone-200 dark:hover:border-accent-700">
                Documentation
              </a>
            )}
          </div>
        </header>

        {data.features.length > 0 && (
          <section class="mb-8 rounded-lg border border-stone-200 bg-stone-50 p-5 dark:border-stone-800 dark:bg-stone-900">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Key features</h2>
            <ul class="space-y-2">
              {data.features.map((feature) => (
                <li class="flex gap-2 text-sm text-stone-700 dark:text-stone-300">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400">
                    <path d="m20 6-11 11-5-5" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {data.screenshots.length > 0 && (
          <section class="mb-8">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Screenshots</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {data.screenshots.map((shot) => (
                <img src={withBase(shot.src)} alt={shot.alt} class="w-full rounded-lg border border-stone-200 dark:border-stone-800" />
              ))}
            </div>
          </section>
        )}

        <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-pre:bg-transparent prose-pre:p-0 prose-img:rounded-lg prose-a:text-accent-600 dark:prose-a:text-accent-400">
          <Content />
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</Layout>
